    "security": "reality",
    "realitySettings": {
      "show": false,
      "xver": 0,
      "target": "vk.com:443",
      "serverNames": [
        "vk.ru",
        "vk.cc",
        "vk.me",
        "vkontakte.com",
        "vkontakte.ru",
        "vk.link",
        "vk.design",
