        "vkvideo.ru",
        "api.vk.ru",
        "m.vk.com",
        "api.vk.com",
        "vk.com",
        "api.r.vk.com",
        "api.r.vk.ru"
      ],
      "privateKey": "REGENERATE PLS",
      "minClientVer": "",
      "maxClientVer": "",
      "maxTimediff": 0,
      "shortIds": [
        "REGENERATE PLS"
      ],
      "mldsa65Seed": "",
      "settings": {
        "publicKey": "REGENERATE PLS",
