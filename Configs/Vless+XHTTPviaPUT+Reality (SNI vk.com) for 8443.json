{
  "listen": "",
  "port": 8443,
  "protocol": "vless",
  "tag": "in-8443-tcpudp",
  "settings": {
    "clients": [ ],
    "decryption": "ML-KEM-768 (random)",
    "encryption": "ML-KEM-768 (random)"
  },
  "sniffing": {
    "enabled": true,
    "destOverride": [
      "http",
      "tls",
      "quic",
      "fakedns"
    ]
  },
  "streamSettings": {
    "network": "xhttp",
    "xhttpSettings": {
      "path": "",
      "host": "vk.com",
