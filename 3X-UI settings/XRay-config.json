{
  "inbounds": [
    {
      "listen": "127.0.0.1",
      "port": 62789,
      "protocol": "tunnel",
      "settings": {
        "rewriteAddress": "127.0.0.1"
      },
      "tag": "api"
    }
  ],
  "outbounds": [
    {
      "tag": "direct",
      "protocol": "freedom",
      "settings": {
        "finalRules": [
          {
            "action": "allow"
          }
        ]
      },
      "streamSettings": {
        "sockopt": {
          "happyEyeballs": {
            "tryDelayMs": 150,
            "prioritizeIPv6": false,
            "interleave": 1,
            "maxConcurrentTry": 4
          },
          "addressPortStrategy": "",
          "tcpFastOpen": true,
          "tcpMptcp": true,
          "penetrate": true,
          "tproxy": "off"
        }
      }
    },
    {
      "tag": "blocked",
      "protocol": "blackhole",
      "settings": { }
    }
  ],
  "routing": {
    "rules": [
      {
        "type": "field",
        "inboundTag": [
          "api"
        ],
        "outboundTag": "api"
      }
    ],
    "domainStrategy": "IPOnDemand"
  },
  "dns": {
    "tag": "dns_inbound",
    "hosts": { },
    "servers": [
      "8.8.8.8",
      "8.8.4.4",
      "1.1.1.1",
      "1.0.0.1",
      "https://cloudflare-dns.com/dns-query",
      "https://dns.google/dns-query",
      "https://dns.quad9.net/dns-query",
      "https://dns.adguard-dns.com/dns-query",
      "quic+local://dns.adguard-dns.com",
      "https://freedns.controld.com/p2",
      "quic+local://p2.freedns.controld.com",
      "https://cfdns.phantom.syberia.network/dns-query",
      "https://gdns.phantom.syberia.network/dns-query"
    ],
    "queryStrategy": "UseIP",
    "disableCache": false,
    "disableFallback": true,
    "disableFallbackIfMatch": true,
    "enableParallelQuery": true,
    "useSystemHosts": true,
    "serveStale": false,
    "serveExpiredTTL": 0
  },
  "log": {
    "access": "none",
    "dnsLog": false,
    "error": "./error.log",
    "loglevel": "error",
    "maskAddress": "full"
  },
  "policy": {
    "system": {
      "statsInboundDownlink": false,
      "statsInboundUplink": false,
      "statsOutboundDownlink": false,
      "statsOutboundUplink": false
    },
    "levels": {
      "0": {
        "statsUserDownlink": true,
        "statsUserUplink": true
      }
    }
  },
  "fakedns": [
    {
      "ipPool": "198.18.0.0/15",
      "poolSize": 65535
    }
  ],
  "api": {
    "services": [
      "HandlerService",
      "LoggerService",
      "StatsService"
    ],
    "tag": "api"
  },
  "metrics": {
    "listen": "127.0.0.1:11111",
    "tag": "metrics_out"
  },
  "stats": { }
}